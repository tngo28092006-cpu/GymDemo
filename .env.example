# Copy this file to .env beside index.py. Never commit .env.
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gym_demo
MYSQL_USER=gym_app
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Set a long random value and keep it stable between restarts.
SECRET_KEY=

# SMTP sender. Fill real credentials locally, without quotes unless needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_FROM=your-sender@gmail.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
